pandoc 

  to: html
  output-file: index.html
  standalone: true
  title-prefix: quarto-gradio
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  toc: true
  css:
    - ../../styles.css
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  code-copy: true
  theme: darkly
  grid:
    sidebar-width: 300px
    body-width: 800px
    margin-width: 200px
  title: Use a Jupyter Notebook
  description: Render Python notebook cells as a browser-run Gradio app while keeping Quarto-side execution disabled.
  

Output created: ../../_site/guide/use-with-jupyter/index.html


