pandoc 

  to: html
  output-file: sentiment-analysis.html
  standalone: true
  title-prefix: quarto-gradio
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  toc: true
  css:
    - ../../styles.css
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  code-copy: true
  theme: darkly
  grid:
    sidebar-width: 300px
    body-width: 800px
    margin-width: 200px
  subtitle: Runnable examples for the frozen Gradio Lite 5.45.0 browser runtime.
  gradio:
    attributes:
      playground: true
      layout: vertical
    requirements:
      - transformers-js-py==0.19.10
  title: Sentiment Analysis
  description: Download a Transformers.js sentiment model and run it through a Python pipeline.
  

Output created: ../../_site/playground/transformers/sentiment-analysis.html


