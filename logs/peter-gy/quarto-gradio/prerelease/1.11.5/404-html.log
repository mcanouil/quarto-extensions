pandoc 

  to: html
  output-file: 404.html
  standalone: true
  title-prefix: quarto-gradio
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  toc: false
  css:
    - styles.css
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  code-copy: true
  theme: darkly
  grid:
    sidebar-width: 300px
    body-width: 800px
    margin-width: 200px
  image: /public/quarto-gradio-bg.png
  title: Page Not Found
  description: Find the current quarto-gradio documentation route.
  search: false
  

Output created: _site/404.html


