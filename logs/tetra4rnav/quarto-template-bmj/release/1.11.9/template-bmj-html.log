pandoc 

  to: html
  output-file: template.html
  standalone: true
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: svg
  number-sections: false
  toc: true
  

metadata

  document-css: false
  link-citations: true
  date-format: long
