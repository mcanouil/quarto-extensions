pandoc 

  to: html
  output-file: my-html-page.html
  standalone: true
  embed-resources: true
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  title: Example HTML Webpage
  

Output created: my-html-page.html


