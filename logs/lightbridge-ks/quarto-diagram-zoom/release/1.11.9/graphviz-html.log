pandoc 

  to: html
  output-file: graphviz.html
  standalone: true
  toc: true
  number-sections: true
  title-prefix: Fixture Book
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  number-offset:
    - 2
  

metadata

  crossref:
    chapters: true
  document-css: false
  link-citations: true
  date-format: long
  lang: en
  hide-description: true
  title: "[2]{.chapter-number}\_ [Graphviz]{.chapter-title}"
  

Output created: _book/graphviz.html


