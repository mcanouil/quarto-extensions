pandoc 

  to: html
  output-file: example.html
  standalone: true
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  title: Veil
  subtitle: One deck for many audiences
  author: Mickaël Canouil
  revealjs-plugins:
    - veil
  extensions:
    veil:
      groups:
        - name: advanced
          level: 1
          shown: true
          label: Advanced
        - name: expert
          level: 2
          shown: false
          label: Expert
        - name: backup
          shown: false
          label: Backup
  

Output created: example.html


