

pandoc 

  to: html
  output-file: explicit.html
  standalone: true
  title-prefix: Gitlink Badge Test
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  extensions:
    gitlink:
      platform: github
      repository-name: mcanouil/quarto-gitlink
      badge-background-colour: '#003366'
      badge-text-colour: '#ffcc00'
  theme:
    light: flatly
    dark: darkly
  title: Explicit text colour
  



Output created: _site/explicit.html


