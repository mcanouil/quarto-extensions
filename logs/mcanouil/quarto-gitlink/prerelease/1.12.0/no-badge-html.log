

pandoc 

  to: html
  output-file: no-badge.html
  standalone: true
  title-prefix: Gitlink Badge Test
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  extensions:
    gitlink:
      platform: github
      repository-name: mcanouil/quarto-gitlink
      show-platform-badge: false
      badge-background-colour: '#ff000040'
  theme:
    light: flatly
    dark: darkly
  title: No badge
  



