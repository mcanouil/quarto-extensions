pandoc 

  to: beamer
  output-file: example.tex
  standalone: true
  pdf-engine: lualatex
  variables:
    graphics: true
    tables: true
  default-image-extension: pdf
  

metadata

  block-headings: true
  title: Typst Render
  subtitle: Quarto Extension
  author:
    - name: Mickaël CANOUIL, _Ph.D._
      orcid: 0000-0002-3396-4549
      url: https://mickael.canouil.fr
  extensions:
    typst-render:
      margin: 0.5em
      math: typst
  aspectratio: 169
  

