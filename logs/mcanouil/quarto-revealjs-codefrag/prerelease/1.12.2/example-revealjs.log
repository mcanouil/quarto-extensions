pandoc 

  to: revealjs
  output-file: /home/runner/work/quarto-extensions/quarto-extensions/test-22/repo/index.html
  standalone: true
  wrap: none
  default-image-extension: png
  html-math-method:
    method: mathjax
    url: >-
      https://cdn.jsdelivr.net/npm/mathjax@2.7.9/MathJax.js?config=TeX-AMS_HTML-full
