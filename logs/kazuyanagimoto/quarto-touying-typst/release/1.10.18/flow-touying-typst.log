pandoc 

  to: typst
  output-file: flow.typ
  standalone: true
  default-image-extension: svg
  wrap: none
  citeproc: false
  

metadata

  theme: default
  aspect-ratio: 16-9
  title: flow
  subtitle: A Touying theme from Typst Universe
  author:
    - name: Your Name
      affiliations: Your Institution
  date: today
  date-format: long
  brand:
    typography:
      monospace: JetBrains Mono
      fonts:
        - family: JetBrains Mono
          source: google
  theme-typst: flow-theme
  

