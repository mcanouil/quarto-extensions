pandoc 

  to: html
  output-file: gallery.html
  standalone: true
  title-prefix: quarto-touying-typst
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  css:
    - styles.css
  toc: false
  toc-depth: 3
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  theme: cosmo
  lightbox: true
  title: Gallery
  

Output created: _site/gallery.html


