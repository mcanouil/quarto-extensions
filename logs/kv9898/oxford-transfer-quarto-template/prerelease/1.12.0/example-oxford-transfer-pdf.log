pandoc 

  to: latex
  output-file: example.tex
  standalone: true
  pdf-engine: lualatex
  variables:
    graphics: true
    tables: true
  default-image-extension: pdf
  toc: true
  toc-depth: 3
  number-sections: true
  listings: true
  

metadata

  block-headings: true
  documentclass: report
  classoption:
    - 12pt
  papersize: a4
  date-format: MMMM YYYY
  lof: true
  lot: true
  lol: true
  linestretch: 1.5
  running-header: false
  minimal-footer: true
  geometry:
    - top=25mm
    - bottom=25mm
    - left=30mm
    - right=30mm
    - includeheadfoot
    - headheight=15pt
  colorlinks: true
  linkcolor: black
  citecolor: blue
  urlcolor: blue
  link-citations: true
