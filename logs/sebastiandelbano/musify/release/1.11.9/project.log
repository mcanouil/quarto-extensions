pandoc 

  to: html
  output-file: example.html
  standalone: true
  embed-resources: true
  self-contained: true
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  toc: true
  syntax-definitions:
    - _extensions/sebastiandelbano/musify/resources/syntax/abc2.xml
  

metadata

  document-css: false
  link-citations: true
  date-format: long
  lang: en
  title: '{{< musify icon >}} Musify'
  toc-location: left
  favicon: resources/images/favicon.png
  copyright:
    text: © 2026, Sebastian del Bano Rollin
  theme:
    dark: darkly
    light: flatly
  


