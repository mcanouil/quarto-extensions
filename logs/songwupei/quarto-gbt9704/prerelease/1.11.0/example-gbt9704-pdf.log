pandoc 

  to: latex
  output-file: example.tex
  standalone: true
  pdf-engine: xelatex
  variables:
    graphics: true
    tables: true
  default-image-extension: pdf
  

metadata

  block-headings: true
  documentclass: gbt9704
  title: 关于印发《公文格式示例》的通知
  header-org: XX单位办公室
  header-number: XX发〔202X〕X号
  header-signatory: 张三
  subtitle: ——关于做好公文格式标准化工作的通知
  mainreceiver: 各有关单位：
  signature: XX单位办公室
  signdate: 202X年X月X日
  notes: 此件公开发布
  copyto: XX部门、XX委员会
  issue-author: XX单位办公室
  issue-date: 202X年X月X日
  attachments:
    - 1. 关于印发《公文处理办法》的通知
    - 2. 公文格式标准对照表
  emoji: true
  classoption:
    - zhlineskip
    - redline
  


